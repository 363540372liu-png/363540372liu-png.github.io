---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getAssetPath } from "@/utils/withBase";
---

<Layout title="返回 Polar Explorer" sensitivePage>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-xl px-6 py-20">
    <h1 class="text-2xl">返回 Polar Explorer</h1>
    <p id="polar-callback-status" class="my-6" role="status">
      正在确认登录状态……
    </p>
    <a id="polar-callback-return" href={getAssetPath("posts/")}>返回阅读</a>
  </main>
  <Footer />
</Layout>
<script>
  import {
    client,
    getTabValue,
    returnPath,
    setTabValue,
  } from "@/lib/polar-client";

  async function finishLogin() {
    const status = document.querySelector("#polar-callback-status");
    const link = document.querySelector<HTMLAnchorElement>(
      "#polar-callback-return"
    );
    if (!status || !link || status.hasAttribute("data-started")) return;
    status.setAttribute("data-started", "");
    const target = returnPath(getTabValue("polar:oauth-return"));
    const destination =
      target.includes("/posts/") && !target.endsWith("/posts/")
        ? `${target}#observations`
        : target;
    link.href = destination;
    const params = new URLSearchParams(location.search);
    const code = params.get("code");
    history.replaceState(history.state, "", location.pathname);
    setTabValue("polar:oauth-return", null);

    try {
      if (!code || params.has("error"))
        throw new Error("OAuth callback failed");
      const { error } = await (
        await client()
      ).auth.exchangeCodeForSession(code);
      if (error) throw error;
      setTabValue("polar:oauth-result", "success");
    } catch {
      setTabValue("polar:oauth-result", "failure");
    }
    location.replace(destination);
  }

  document.addEventListener("astro:page-load", finishLogin);
  void finishLogin();
</script>
