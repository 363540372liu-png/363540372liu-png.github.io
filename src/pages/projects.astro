---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getProjects } from "@/utils/getProjects";
import "@/styles/projects.css";

const projects = await getProjects();
const date = new Intl.DateTimeFormat("zh-CN", {
  timeZone: "UTC",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<Layout
  title="项目档案 | Polar Explorer"
  description="精选工程实践、交互教学与开源项目。GitHub 公开仓库信息定期同步。"
>
  <Header />
  <main id="main-content" class="project-atlas">
    <header class="project-intro">
      <div>
        <p class="project-eyebrow">POLAR EXPLORER / PROJECT LOG</p>
        <h1>正在构建，<span>也正在记录。</span></h1>
      </div>
      <p>
        从芯片与硬件到数字学习工具。这里不是所有代码仓库的镜像，
        而是持续整理、可以追溯的个人实践档案。
      </p>
    </header>

    <div class="project-ledger-heading">
      <span>精选公开项目 / {String(projects.length).padStart(2, "0")}</span>
      <span>CODE · PROCESS · EVIDENCE</span>
    </div>
    {
      projects.length ? (
        <ol class="project-ledger">
          {projects.map((project, index) => (
            <li class="project-record">
              <span class="project-record-number" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <article>
                <div class="project-record-meta">
                  <span>{project.category}</span>
                  <span>{project.status}</span>
                </div>
                <h2>
                  <a
                    href={project.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.title} <span aria-hidden="true">↗</span>
                  </a>
                </h2>
                <p class="project-record-description">{project.description}</p>
                <ul class="project-record-tags" aria-label="技术标签">
                  {project.tags.map(tag => (
                    <li>{tag}</li>
                  ))}
                </ul>
                <p class="project-github-info">
                  <span>GitHub / {project.repo}</span>
                  {project.language && (
                    <span>主要语言：{project.language}</span>
                  )}
                  {project.pushedAt && (
                    <span>
                      代码更新：{date.format(new Date(project.pushedAt))}
                    </span>
                  )}
                </p>
                <div class="project-actions">
                  <a
                    href={project.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    浏览 GitHub 源码 ↗
                  </a>
                  {project.detailHref && (
                    <a
                      href={project.detailHref}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      阅读项目记录 ↗
                    </a>
                  )}
                </div>
              </article>
              <div class="project-record-symbol" aria-hidden="true">
                {project.id === "fpga-edge" ? (
                  <svg
                    viewBox="0 0 120 120"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1"
                  >
                    <path d="M22 30h76v60H22zM35 20v10m18-10v10m18-10v10m18-10v10M35 90v10m18-10v10m18-10v10m18-10v10" />
                    <path d="M36 68l12-15 12 10 15-21 10 9M36 77h49M26 39h10m-10 10h10" />
                    <circle cx="75" cy="42" r="4" />
                  </svg>
                ) : (
                  <svg
                    viewBox="0 0 120 120"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1"
                  >
                    <path d="M22 35h76v50H22zM32 48h15l8 9 10-20 12 27 11-11" />
                    <path d="M38 20v15m22-15v15m22-15v15M38 85v15m22-15v15m22-15v15" />
                    <circle cx="22" cy="35" r="3" />
                    <circle cx="98" cy="85" r="3" />
                  </svg>
                )}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="project-bottom">
          当前精选列表暂无可展示的公开项目。请检查 GitHub 仓库状态。
        </p>
      )
    }
    <div class="project-bottom">
      <p>
        作品由记录者精选，项目说明和完成状态手动维护； 代码更新时间等 GitHub
        信息在网站构建时同步。 新创建的仓库不会自动公开展示在这里。
      </p>
      <a class="project-return" href="/#projects">← 返回地图中的项目章节</a>
    </div>
  </main>
  <Footer />
</Layout>
