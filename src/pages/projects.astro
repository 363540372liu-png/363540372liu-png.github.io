---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { projects } from "@/data/polar";
import "@/styles/explorer.css";
---

<Layout title="Projects | Polar Explorer" description="项目、实验与实践记录。"
  ><Header /><main id="main-content" class="explorer-page">
    <p class="section-kicker">PROJECTS / 实践</p><h1 class="page-heading">
      Projects
    </h1><p class="region-description">
      记录问题、过程与成果。每一项实践，都是地图上的一次落笔。
    </p><div class="project-grid">
      {
        projects.map(project => (
          <article class="project-entry">
            {project.cover && (
              <img
                src={project.cover}
                alt={project.title + " 项目封面"}
                loading="lazy"
                width="720"
                height="480"
              />
            )}
            <p class="sample-note">{project.status}</p>
            <p>{project.description}</p>
            {project.tags.length > 0 && (
              <ul class="journal-tags">
                {project.tags.map(tag => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}
            {project.href ? (
              <a class="text-link" href={project.href}>
                项目详情 ↗
              </a>
            ) : (
              <p class="project-pending">项目详情尚未提供</p>
            )}
          </article>
        ))
      }
    </div><a class="return-map" href="/#hero">← 返回首页地图</a>
  </main><Footer /></Layout
>
