---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import JournalCard from "@/components/JournalCard.astro";
import PolarMap from "@/components/PolarMap.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { regions } from "@/data/regions";
import { exploring } from "@/data/polar";
import { projects } from "@/data/polar";
import "@/styles/polar.css";
import "@/styles/explorer.css";
const posts = getSortedPosts(await getCollection("posts"));
const featured = posts.find(post => post.data.featured);
const journal = posts.filter(post => post.id !== featured?.id).slice(0, 3);
---

<Layout
  title="Polar Explorer — An Unfinished Atlas"
  description="企鹅的个人数字空间，记录技术探索、学习笔记与生活思考。"
  ><Header /><main id="main-content" class="polar-home">
    <section id="hero" class="polar-hero">
      <div class="hero-copy">
        <p class="eyebrow">PERSONAL ATLAS / VOL. 02</p><h1>
          An unfinished<br />atlas<span>一张尚未绘制完成的地图</span>
        </h1><p class="intro">
          你好，我是企鹅。<br />在技术与生活之间，记录观察、留下思考。<br
          />保持好奇，向尚未抵达的地方走去。
        </p><div class="hero-links">
          <a href="/posts/">阅读 Journal ↗</a><a href="/about/">关于我 ↗</a>
        </div><p class="hero-foot">独立记录 · 持续探索</p>
      </div><div class="hero-map">
        <PolarMap /><div class="map-caption">
          <span>FIG. 01 / THE QUIET CONTINENT</span><span
            >NOAA 地形艺术 · 探索微光坐标</span
          >
        </div>
      </div>
    </section><div class="atlas-index">
      <span>向留白处探索</span><span>FOUR PLACES / AN UNFINISHED ATLAS</span
      ><span>SCROLL ↓</span>
    </div><section class="region-directory" aria-label="四大探索区域">
      {
        regions.map(region => (
          <a
            href={"/regions/" + region.id + "/"}
            style={"--region-accent:" + region.color}
          >
            <>
              <span aria-hidden="true">{region.symbol}</span>
              <b>{region.name}</b>
              <small>{region.english}</small>
            </>
          </a>
        ))
      }
    </section><section class="home-journal">
      <div class="section-heading">
        <div>
          <p class="eyebrow">FIELD NOTES / 沿途记录</p><h2>Latest journal</h2>
        </div><a class="text-link" href="/posts/">浏览全部文章 ↗</a>
      </div><p class="sample-note">
        保留的 AstroPaper 教程属于模板示例；文章不会被自动归入探索区域。
      </p><div
        class:list={["journal-grid", { "has-featured": Boolean(featured) }]}
      >
        {featured && <JournalCard post={featured} large />}{
          journal.map(post => <JournalCard {post} />)
        }
      </div>
    </section><section class="explore-section explore-editorial">
      <div>
        <p class="eyebrow">ON THE HORIZON</p><h2>Currently exploring</h2><p>
          留一块空白，给下一次好奇。
        </p>
      </div><div class="explore-modules">
        {
          exploring.map(item => (
            <details>
              <>
                <summary>
                  {item.title}
                  <span aria-hidden="true">＋</span>
                </summary>
                <p>{item.text}</p>
              </>
            </details>
          ))
        }
      </div>
    </section><section class="lower-grid">
      <div>
        <p class="eyebrow">PROJECTS / 实践</p><h2>Projects</h2>{
          projects.map(project => (
            <article>
              <>
                <p class="sample-note">{project.status}</p>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
              </>
            </article>
          ))
        }<a class="text-link" href="/projects/">进入研究站 ↗</a>
      </div><div>
        <p class="eyebrow">ABOUT / 记录者</p><h2>
          保持观察。<br />允许地图尚未完成。
        </h2><p>
          这里记录技术探索、学习笔记、项目实践，也收藏生活中值得思考的事情。
        </p><a class="text-link" href="/about/">认识记录的人 ↗</a>
      </div>
    </section>
  </main><Footer /></Layout
>
