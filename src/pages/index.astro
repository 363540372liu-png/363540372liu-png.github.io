---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import JournalCard from "@/components/JournalCard.astro";
import PolarMap from "@/components/PolarMap.astro";
import RegionGlyph from "@/components/RegionGlyph.astro";
import ObservationSeal from "@/components/ObservationSeal.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { regions } from "@/data/regions";
import { getProjects } from "@/utils/getProjects";
import "@/styles/polar.css";
import "@/styles/explorer.css";
const posts = getSortedPosts(await getCollection("posts"));
// The homepage is a recent-entries index, not an all-posts listing.
const journal = [...posts]
  .sort(
    (a, b) =>
      new Date(b.data.pubDatetime).getTime() -
      new Date(a.data.pubDatetime).getTime()
  )
  .slice(0, 3);
const projects = await getProjects();
---

<Layout
  title="Polar Explorer — An Unfinished Atlas"
  description="企鹅的个人数字空间，记录技术探索、学习笔记与生活思考。"
  ><Header /><main id="main-content" class="polar-home">
    <section id="hero" data-home-section class="polar-hero">
      <div class="hero-copy">
        <h1>
          <span class="atlas-title-line">An unfinished</span><em>atlas</em><span
            >一张尚未绘制完成的地图</span
          >
        </h1><p class="intro">
          你好，我是企鹅。<br />在技术与生活之间，记录观察、留下思考。<br
          />保持好奇，向尚未抵达的地方走去。
        </p><div class="hero-links">
          <a href="#journal">阅读文章 ↓</a><a href="#about">观察者 ↓</a>
        </div><p class="hero-foot">独立记录 · 持续探索</p>
      </div><div class="hero-map">
        <PolarMap />
      </div>
    </section><section
      class="home-regions"
      data-reveal
      aria-labelledby="regions-title"
    >
      <div class="chapter-intro">
        <h2 id="regions-title">沿着坐标，<br />继续探索。</h2>

        <p class="chapter-note">
          有些记录向外追问，<br />有些只是为内心留一处停靠。
        </p>
        <a class="chapter-map-link" href="#hero">回到地图 ↑</a>
      </div>
      <div class="region-directory">
        {
          regions.map(region => (
            <a
              class="region-file"
              href={`/regions/${region.id}/`}
              style={`--region-accent:${region.color}`}
            >
              <div class="region-file-top">
                <>
                  <span class="entry-arrow" aria-hidden="true">
                    ↗
                  </span>
                </>
              </div>
              <RegionGlyph id={region.id} />
              <h3>{region.name}</h3>

              <p class="region-file-description">
                {region.description.split("。")[0]}。
              </p>
              <div class="region-file-bottom">
                <>
                  <span>{region.location}</span>
                  <span>
                    {
                      posts.filter(post => post.data.region === region.id)
                        .length
                    }{" "}
                    篇记录
                  </span>
                </>
              </div>
            </a>
          ))
        }
      </div>
    </section><section
      id="journal"
      class="home-journal"
      data-home-section
      data-reveal
      aria-labelledby="journal-title"
    >
      <div class="chapter-intro">
        <h2 id="journal-title">写下的<br />与想起的。</h2>
        <a class="text-link" href="/posts/">翻阅全部日志 ↗</a>
      </div><div class="journal-grid">
        {journal.map(post => <JournalCard {post} />)}
      </div>
    </section><section
      id="projects"
      class="home-projects"
      data-home-section
      data-reveal
      aria-labelledby="projects-title"
    >
      <div class="chapter-intro">
        <h2 id="projects-title">正在成形的项目。</h2>
        <p class="chapter-note">精选公开项目，连接源码与工程记录。</p>
        <a class="text-link" href="/projects/">查看完整项目档案 ↗</a>
      </div>
      <div class="home-project-list">
        {
          projects.map(project => (
            <article class="home-project-entry">
              {project.cover && (
                <img
                  src={project.cover}
                  alt={project.title + " 项目封面"}
                  loading="lazy"
                  width="720"
                  height="480"
                />
              )}
              <p class="project-status">{project.status}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              {project.tags.length > 0 && (
                <ul class="journal-tags">
                  {project.tags.map(tag => (
                    <li>{tag}</li>
                  ))}
                </ul>
              )}
              {project.href ? (
                <a class="text-link" href={project.href}>
                  项目详情 ↗
                </a>
              ) : null}
            </article>
          ))
        }
      </div>
    </section><section
      id="about"
      data-home-section
      class="home-about"
      data-reveal
      aria-labelledby="about-explorer"
    >
      <div class="observer-home-identity">
        <ObservationSeal /><div>
          <h2 id="about-explorer">观察者</h2>
        </div>
      </div>
      <div class="observer-home-statement">
        <p class="about-line">
          保持观察。<br /><span>允许地图尚未完成。</span>
        </p>
        <p>你好，我是企鹅。<br />在技术与生活之间，记录观察、留下思考。</p>
        <a class="text-link" href="/about/">关于这位观察者 ↗</a>
      </div>
    </section>
  </main><Footer /></Layout
>
