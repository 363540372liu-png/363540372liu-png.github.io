---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import PolarMap from "@/components/PolarMap.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { projects } from "@/data/polar";
import "@/styles/polar.css";
const posts = getSortedPosts(await getCollection("posts")).slice(0, 3);
---

<Layout
  title="Polar Explorer — An Unfinished Atlas"
  description="企鹅的个人数字空间，记录技术探索、学习笔记与生活思考。"
  ><Header /><main id="main-content" class="polar-home">
    <section class="polar-hero">
      <div class="hero-copy">
        <p class="eyebrow">PERSONAL ATLAS / VOL. 02</p><h1>
          An unfinished<br />atlas<span>一张尚未绘制完成的地图</span>
        </h1><p class="intro">
          你好，我是企鹅。<br />在技术与生活之间，记录观察、留下思考。<br
          />保持好奇，向尚未抵达的地方走去。
        </p><div class="hero-links">
          <a href="/posts/">阅读 Journal ↗</a><a href="/about/">关于我 ↗</a>
        </div><p class="hero-foot">独立记录 · 持续探索 · V2 ALPHA</p>
      </div><div class="hero-map">
        <PolarMap /><div class="map-caption">
          <span>FIG. 01 / THE QUIET CONTINENT</span><span
            >艺术示意 · 探索编号节点</span
          >
        </div>
      </div>
    </section><div class="atlas-index">
      <span>向留白处探索</span><span
        >01 JOURNAL / 02 PROJECTS / 03 OBSERVER</span
      ><span>SCROLL ↓</span>
    </div><section class="journal-section">
      <div>
        <p class="eyebrow">01 / FIELD NOTES</p><h2>Latest journal</h2><p>
          文字是沿途留下的坐标。
        </p><a class="text-link" href="/posts/">浏览全部文章 ↗</a>
      </div><div>
        <p class="sample-note">
          以下保留的 AstroPaper 教程为模板示例，不代表个人原创。
        </p><ul>{posts.map(post => <Card variant="h3" {...post} />)}</ul>
      </div>
    </section><section class="explore-section">
      <div>
        <p class="eyebrow">ON THE HORIZON</p><h2>Currently exploring</h2><p>
          留一块空白，给下一次好奇。
        </p>
      </div><p>
        近期探索内容待补充。<br />阅读、实验与尚未成形的想法，会在这里慢慢汇集。
      </p>
    </section><section class="lower-grid">
      <div>
        <p class="eyebrow">02 / RESEARCH STATION</p><h2>Projects</h2>{
          projects.map(project => (
            <article>
              <>
                <p class="sample-note">{project.status}</p>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
              </>
            </article>
          ))
        }<a class="text-link" href="/projects/">进入研究站 ↗</a>
      </div><div>
        <p class="eyebrow">03 / OBSERVER</p><h2>
          保持观察。<br />允许地图尚未完成。
        </h2><p>
          这里记录技术探索、学习笔记、项目实践，也收藏生活中值得思考的事情。
        </p><a class="text-link" href="/about/">认识记录的人 ↗</a>
      </div>
    </section>
  </main><Footer /></Layout
>
