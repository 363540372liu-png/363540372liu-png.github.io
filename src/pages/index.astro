---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-10 pb-9">
      <p class="text-accent mb-4 text-sm font-semibold tracking-widest">
        PERSONAL SPACE · NOTES &amp; IDEAS
      </p>
      <h1 class="my-3 text-4xl font-bold leading-tight sm:text-5xl">
        你好，欢迎来到我的个人空间。
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed">
        我是企鹅。这里记录技术探索、学习笔记、项目实践，也收藏生活中值得思考的事情。
      </p>
      <p class="text-muted-foreground mt-3 leading-relaxed">
        这个网站刚刚起步，会随着我的学习与经历慢慢生长。
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
        <LinkButton
          class="text-accent font-medium underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "posts")}
        >
          阅读文章
          <IconArrowRight class="inline-block" />
        </LinkButton>
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "about")}
        >
          关于我
        </LinkButton>
        <a
          href="/rss.xml"
          class="text-muted-foreground hover:text-accent inline-flex items-center"
          aria-label="RSS 订阅"
          title="RSS 订阅"
        >
          <IconRss width={20} height={20} class="stroke-current stroke-2" />
        </a>
      </div>

      {
        socials.length > 0 && (
          <div class="mt-7 flex items-center gap-2">
            <span class="text-muted-foreground text-sm">{t.home.socialLinks}：</span>
            <Socials />
          </div>
        )
      }
    </section>

    <section class="border-border border-b py-9">
      <h2 class="text-2xl font-semibold">这里会有什么？</h2>
      <ul class="mt-5 grid gap-5 sm:grid-cols-3">
        <li>
          <h3 class="font-semibold">技术与项目</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            工程实践、代码、实验与踩过的坑。
          </p>
        </li>
        <li>
          <h3 class="font-semibold">学习与成长</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            整理知识，也记录理解变化的过程。
          </p>
        </li>
        <li>
          <h3 class="font-semibold">生活与思考</h3>
          <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
            书影音、见闻与偶尔的自我提问。
          </p>
        </li>
      </ul>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <p class="text-muted-foreground mt-3 text-sm">
            当前展示的是 AstroPaper 模板自带文章；个人文章发布后将逐步替换这些示例。
          </p>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
