---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import JournalCard from "@/components/JournalCard.astro";
import PolarMap from "@/components/PolarMap.astro";
import RegionGlyph from "@/components/RegionGlyph.astro";
import ObservationSeal from "@/components/ObservationSeal.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { regions } from "@/data/regions";
import "@/styles/polar.css";
import "@/styles/explorer.css";
const posts = getSortedPosts(await getCollection("posts"));
const featured = posts.find(post => post.data.featured);
const journal = posts.filter(post => post.id !== featured?.id).slice(0, 3);
---

<Layout
  title="Polar Explorer — An Unfinished Atlas"
  description="企鹅的个人数字空间，记录技术探索、学习笔记与生活思考。"
  ><Header /><main id="main-content" class="polar-home">
    <section id="hero" class="polar-hero">
      <div class="hero-copy">
        <p class="eyebrow">PERSONAL ATLAS / VOL. 02</p><h1>
          An unfinished<br /><em>atlas</em><span>一张尚未绘制完成的地图</span>
        </h1><p class="intro">
          你好，我是企鹅。<br />在技术与生活之间，记录观察、留下思考。<br
          />保持好奇，向尚未抵达的地方走去。
        </p><div class="hero-links">
          <a href="/posts/">阅读 Journal ↗</a><a href="/about/">观察者 ↗</a>
        </div><p class="hero-foot">独立记录 · 持续探索</p>
      </div><div class="hero-map">
        <PolarMap /><div class="map-caption">
          <span>FIG. 01 / THE QUIET CONTINENT</span>
        </div>
      </div>
    </section><section
      class="home-regions"
      data-reveal
      aria-labelledby="regions-title"
    >
      <div class="chapter-intro">
        <p class="eyebrow">02 / THE COORDINATES</p>
        <h2 id="regions-title">沿着坐标，<br />继续探索。</h2>
        <p class="chapter-english">Explore the Regions</p>
        <p class="chapter-note">
          有些记录向外追问，<br />有些只是为内心留一处停靠。
        </p>
        <a class="chapter-map-link" href="#hero">回到地图 ↑</a>
      </div>
      <div class="region-directory">
        {
          regions.map((region, index) => (
            <a
              class="region-file"
              href={`/regions/${region.id}/`}
              style={`--region-accent:${region.color}`}
            >
              <div class="region-file-top">
                <>
                  <span class="region-index">0{index + 1}</span>
                  <span class="region-file-kind">{region.recordLabel}</span>
                  <span class="entry-arrow" aria-hidden="true">
                    ↗
                  </span>
                </>
              </div>
              <RegionGlyph id={region.id} />
              <h3>{region.name}</h3>
              <p class="region-file-english">{region.english}</p>
              <p class="region-file-description">
                {region.description.split("。")[0]}。
              </p>
              <div class="region-file-bottom">
                <>
                  <span>{region.location}</span>
                  <span>
                    {
                      posts.filter(post => post.data.region === region.id)
                        .length
                    }{" "}
                    篇记录
                  </span>
                </>
              </div>
            </a>
          ))
        }
      </div>
    </section><section class="home-journal" data-reveal>
      <div class="chapter-intro">
        <p class="eyebrow">03 / FIELD NOTES</p><h2>最近的<br />记录。</h2><p
          class="chapter-english"
        >
          Latest journal
        </p>
        <a class="text-link" href="/posts/">翻阅全部日志 ↗</a>
      </div><div
        class:list={["journal-grid", { "has-featured": Boolean(featured) }]}
      >
        {featured && <JournalCard post={featured} large />}{
          journal.map(post => <JournalCard {post} />)
        }
      </div>
    </section><section
      class="home-about"
      data-reveal
      aria-labelledby="about-explorer"
    >
      <div class="observer-home-identity">
        <ObservationSeal /><div>
          <p class="eyebrow">04 / THE OBSERVER</p><h2 id="about-explorer">
            观察者
          </h2><p class="chapter-english">The Observer</p>
        </div>
      </div>
      <div class="observer-home-statement">
        <p class="about-line">
          保持观察。<br /><span>允许地图尚未完成。</span>
        </p><p>
          你好，我是企鹅。<br />在技术与生活之间，记录观察、留下思考。
        </p><a class="text-link" href="/about/">关于这位观察者 ↗</a>
      </div>
    </section>
  </main><Footer /></Layout
>
