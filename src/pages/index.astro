---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import JournalCard from "@/components/JournalCard.astro";
import PolarMap from "@/components/PolarMap.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { regions } from "@/data/regions";
import "@/styles/polar.css";
import "@/styles/explorer.css";
const posts = getSortedPosts(await getCollection("posts"));
const featured = posts.find(post => post.data.featured);
const journal = posts.filter(post => post.id !== featured?.id).slice(0, 3);
---

<Layout
  title="Polar Explorer — An Unfinished Atlas"
  description="企鹅的个人数字空间，记录技术探索、学习笔记与生活思考。"
  ><Header /><main id="main-content" class="polar-home">
    <section id="hero" class="polar-hero">
      <div class="hero-copy">
        <p class="eyebrow">PERSONAL ATLAS / VOL. 02</p><h1>
          An unfinished<br />atlas<span>一张尚未绘制完成的地图</span>
        </h1><p class="intro">
          你好，我是企鹅。<br />在技术与生活之间，记录观察、留下思考。<br
          />保持好奇，向尚未抵达的地方走去。
        </p><div class="hero-links">
          <a href="/posts/">阅读 Journal ↗</a><a href="/about/">观察者 ↗</a>
        </div><p class="hero-foot">独立记录 · 持续探索</p>
      </div><div class="hero-map">
        <PolarMap /><div class="map-caption">
          <span>FIG. 01 / THE QUIET CONTINENT</span>
        </div>
      </div>
    </section><section
      class="home-regions"
      data-reveal
      aria-labelledby="regions-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / THE COORDINATES</p><h2 id="regions-title">
            Explore the Regions
          </h2>
        </div>
      </div><div class="region-directory">
        {
          regions.map((region, index) => (
            <a
              href={"/regions/" + region.id + "/"}
              data-reveal
              style={
                "--region-accent:" +
                region.color +
                ";--reveal-delay:" +
                index * 60 +
                "ms"
              }
            >
              <>
                <span class="region-index">
                  0{index + 1} / {region.symbol}
                </span>
                <b>{region.name}</b>
                <>
                  <small>{region.english}</small>
                  <p>{region.description.split("。")[0]}。</p>
                  <span class="entry-arrow" aria-hidden="true">
                    ↗
                  </span>
                </>
              </>
            </a>
          ))
        }
      </div>
    </section><section class="home-journal" data-reveal>
      <div class="section-heading">
        <div>
          <p class="eyebrow">03 / FIELD NOTES</p><h2>Latest journal</h2>
        </div><a class="text-link" href="/posts/">浏览全部文章 ↗</a>
      </div><p class="sample-note">
        保留的 AstroPaper 教程属于模板示例；文章不会被自动归入探索区域。
      </p><div
        class:list={["journal-grid", { "has-featured": Boolean(featured) }]}
      >
        {featured && <JournalCard post={featured} large />}{
          journal.map(post => <JournalCard {post} />)
        }
      </div>
    </section><section
      class="home-about"
      data-reveal
      aria-labelledby="about-explorer"
    >
      <div>
        <p class="eyebrow">04 / THE OBSERVER</p><h2 id="about-explorer">
          The Observer
        </h2>
      </div><div>
        <p class="about-line">保持观察。<br />允许地图尚未完成。</p><p>
          你好，我是企鹅。在这里记录技术探索、学习笔记与生活思考，为尚未抵达的地方留一块空白。
        </p><a class="text-link" href="/about/"
          >观察者 <span class="entry-arrow" aria-hidden="true">↗</span></a
        >
      </div>
    </section>
  </main><Footer /></Layout
>
