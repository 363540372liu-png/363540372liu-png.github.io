---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { regions } from "@/data/regions";
import "@/styles/identity.css";
type Props = { pageTitle?: string };
const { pageTitle } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const segments = stripLocale(stripBase(Astro.url.pathname), locale)
  .split("/")
  .filter(Boolean);
const region = regions.find(item => item.id === segments[1]);
const sections: Record<string, string> = {
  posts: "文章",
  projects: "项目",
  about: "关于我",
  tags: "标签",
  archives: "归档",
  search: "搜索",
  "404": "未找到页面",
  regions: "探索区域",
};
const location = region?.name ?? sections[segments[0]] ?? "南极地图";
const links = [
  { path: "", label: "地图", anchor: "hero" },
  { path: "posts", label: "文章", anchor: "journal" },
  { path: "projects", label: "项目", anchor: "projects" },
  { path: "about", label: "关于", anchor: "about" },
];
const utilities = [
  { path: "tags", label: "按标签阅读", enabled: true },
  {
    path: "archives",
    label: "文章归档",
    enabled: config.features.showArchives,
  },
  { path: "search", label: "搜索", enabled: config.features.search !== false },
].filter(item => item.enabled);
const isActive = (path: string) =>
  path === "" ? segments.length === 0 : segments[0] === path;
---

<a id="skip-to-content" href="#main-content" class="folio-skip"
  >{t.a11y.skipToContent}</a
>
<header class="folio-header">
  {
    segments.length > 0 && (
      <nav class="folio-location" aria-label="当前位置">
        <>
          <a href={getRelativeLocaleUrl(locale, "")}>地图</a>
          <span aria-hidden="true">/</span>
        </>
        {pageTitle && segments[0] === "posts" ? (
          <>
            <a href={getRelativeLocaleUrl(locale, "posts")}>{location}</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{pageTitle}</span>
          </>
        ) : (
          <span aria-current="page">
            {segments[0] === "tags" && segments[1]
              ? `${location} · ${decodeURIComponent(segments[1])}`
              : location}
          </span>
        )}
      </nav>
    )
  }
  <details class="folio-index">
    <summary class="folio-index-toggle"
      ><span>展开索引</span><svg
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.2"
        aria-hidden="true"><path d="M4 8h16M4 16h11"></path></svg
      ></summary
    >
    <div class="folio-index-sheet">
      <p class="index-heading">去往何处？</p>
      <nav class="index-destinations" aria-label="地图区域索引">
        {
          regions.map(item => (
            <a
              href={getRelativeLocaleUrl(locale, `regions/${item.id}`)}
              aria-current={region?.id === item.id ? "page" : undefined}
            >
              <>
                <span class="destination-name">{item.name}</span>
                <span class="destination-note">{item.motto}</span>
                <svg
                  viewBox="0 0 24 24"
                  width="20"
                  height="20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.2"
                  aria-hidden="true"
                >
                  <path d="M5 19 19 5M5 5h14v14" />
                </svg>
              </>
            </a>
          ))
        }
      </nav>
      <nav class="index-pages" aria-label="网站页面">
        {
          links.map(item => (
            <a
              href={`${getRelativeLocaleUrl(locale, "")}#${item.anchor}`}
              data-home-link={item.anchor}
              data-astro-reload={segments.length > 0 ? true : undefined}
              aria-current={
                isActive(item.path)
                  ? segments.length === 0
                    ? "location"
                    : "page"
                  : undefined
              }
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <nav class="index-utilities" aria-label="阅读工具">
        {
          utilities.map(item => (
            <a href={getRelativeLocaleUrl(locale, item.path)}>{item.label}</a>
          ))
        }
      </nav>
      <button type="button" class="index-close" data-close-index
        >收起索引 <span aria-hidden="true">×</span></button
      >
    </div>
  </details>
  <nav
    class="folio-margin"
    aria-label="常用页面"
    data-scroll-nav={segments.length === 0 ? "" : undefined}
  >
    {
      links.map(item => (
        <a
          href={`${getRelativeLocaleUrl(locale, "")}#${item.anchor}`}
          data-home-link={item.anchor}
          data-astro-reload={segments.length > 0 ? true : undefined}
          aria-current={
            isActive(item.path)
              ? segments.length === 0
                ? "location"
                : "page"
              : undefined
          }
        >
          {item.label}
        </a>
      ))
    }
  </nav>
  {
    config.features.lightAndDarkMode && (
      <button
        id="theme-btn"
        type="button"
        class="folio-theme"
        title={t.a11y.toggleTheme}
        aria-label="auto"
        aria-live="polite"
      >
        <>
          <IconMoon class="theme-moon" />
          <IconSunHigh class="theme-sun" />
          <span class="sr-only">{t.a11y.toggleTheme}</span>
        </>
      </button>
    )
  }
</header>
<script>
  let cleanup: (() => void) | undefined;
  function setupFolio() {
    cleanup?.();
    const controller = new AbortController();
    const { signal } = controller;
    const index = document.querySelector<HTMLDetailsElement>(".folio-index");
    const toggle = index?.querySelector<HTMLElement>("summary");
    const homeSections = Array.from(
      document.querySelectorAll<HTMLElement>("[data-home-section]")
    );
    const homeLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-home-link]")
    );
    let frame = 0;
    // Short closing sections can share a viewport; keep an explicit choice until the reader scrolls.
    let chosenSection = homeSections.find(
      section => `#${section.id}` === location.hash
    );
    function updateSection() {
      frame = 0;
      if (!homeSections.length) return;
      const readingLine = innerHeight * 0.35;
      const atBottom =
        scrollY + innerHeight >= document.documentElement.scrollHeight - 2;
      const active =
        chosenSection ??
        (atBottom
          ? homeSections[homeSections.length - 1]
          : (homeSections
              .filter(
                section => section.getBoundingClientRect().top <= readingLine
              )
              .at(-1) ?? homeSections[0]));
      homeLinks.forEach(link => {
        if (link.dataset.homeLink === active.id)
          link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
      document
        .querySelector<HTMLElement>(".folio-margin")
        ?.style.setProperty(
          "--active-section",
          String(homeSections.indexOf(active))
        );
    }
    function scheduleSection() {
      if (!frame) frame = requestAnimationFrame(updateSection);
    }
    if (homeSections.length) {
      updateSection();
      window.addEventListener("scroll", scheduleSection, {
        passive: true,
        signal,
      });
      window.addEventListener("resize", scheduleSection, { signal });
      const resumeTracking = () => {
        chosenSection = undefined;
        scheduleSection();
      };
      window.addEventListener("wheel", resumeTracking, {
        passive: true,
        signal,
      });
      window.addEventListener("touchmove", resumeTracking, {
        passive: true,
        signal,
      });
      window.addEventListener("pointerdown", resumeTracking, { signal });
      window.addEventListener(
        "popstate",
        () => {
          chosenSection = homeSections.find(
            section => `#${section.id}` === location.hash
          );
          scheduleSection();
        },
        { signal }
      );
      window.addEventListener(
        "keydown",
        event => {
          if (
            [
              "ArrowDown",
              "ArrowUp",
              "PageDown",
              "PageUp",
              "Home",
              "End",
              " ",
            ].includes(event.key)
          )
            resumeTracking();
        },
        { signal }
      );
    }
    homeLinks.forEach(link =>
      link.addEventListener(
        "click",
        event => {
          if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
            return;
          chosenSection = homeSections.find(
            section => section.id === link.dataset.homeLink
          );
          scheduleSection();
          closeIndex();
        },
        { signal }
      )
    );
    function closeIndex(restoreFocus = false) {
      if (!index?.open) return;
      index.open = false;
      if (restoreFocus) toggle?.focus();
    }
    document.addEventListener(
      "keydown",
      event => {
        if (event.key === "Escape" && index?.open) closeIndex(true);
      },
      { signal }
    );
    document.addEventListener(
      "click",
      event => {
        if (!index?.contains(event.target as Node)) closeIndex();
      },
      { signal }
    );
    index
      ?.querySelector("[data-close-index]")
      ?.addEventListener("click", () => closeIndex(true), { signal });
    document.getElementById("skip-to-content")?.addEventListener(
      "click",
      event => {
        const target = document.getElementById("main-content");
        if (
          !target ||
          event.ctrlKey ||
          event.metaKey ||
          event.shiftKey ||
          event.altKey
        )
          return;
        event.preventDefault();
        target.setAttribute("tabindex", "-1");
        target.focus({ preventScroll: true });
        target.scrollIntoView();
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          { once: true }
        );
      },
      { signal }
    );
    cleanup = () => {
      controller.abort();
      cancelAnimationFrame(frame);
    };
  }
  document.addEventListener("astro:page-load", setupFolio);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
