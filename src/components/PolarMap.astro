---
import { regions } from "@/data/regions";
import { discoveries } from "@/data/polar";
import { Image } from "astro:assets";
import polarReference from "@/assets/antarctica-etopo-2022.webp";
---

<div class="atlas">
  <div class="atlas-art">
    <Image
      src={polarReference}
      alt="基于 NOAA ETOPO 2022 冰面高程独立渲染的南极与南大洋艺术浮雕地图"
      widths={[640, 960, 1440]}
      sizes="(max-width: 800px) 100vw, 65vw"
      format="webp"
      quality={85}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  {
    regions.map(region => (
      <a
        class="map-node region-node"
        data-region={region.id}
        style={`left:${region.position.left}%;top:${region.position.top}%;--node-accent:${region.color}`}
        aria-label={region.name + "：" + region.description}
        href={"/regions/" + region.id + "/"}
      >
        <>
          <span aria-hidden="true" />
          <b>
            {region.name} ↗
            <>
              <small>{region.english}</small>
              <small>
                {region.fictional
                  ? "虚构站点 · 谈心与生活"
                  : region.id === "inaccessibility"
                    ? "保留探索区域"
                    : region.id === "dry-valleys"
                      ? "学习、研究与科学记录"
                      : "社会、文化与现实观察"}
              </small>
            </>
          </b>
        </>
      </a>
    ))
  }
  {
    discoveries.map((item, i) => (
      <button
        class:list={["map-node", i === 0 ? "core" : "signal"]}
        data-discovery={item.id}
        aria-haspopup="dialog"
        aria-label={item.title}
      >
        <>
          <span aria-hidden="true" />
          <b>{item.title} +</b>
        </>
      </button>
    ))
  }
</div><nav class="region-mobile-nav" aria-label="四大探索区域">
  {regions.map(region => <a href={`/regions/${region.id}/`}>{region.name}</a>)}
</nav><p class="explore-hint">探索微光 · 四处坐标，四种观察</p>
{
  discoveries.map(item => (
    <dialog id={item.id} aria-labelledby={item.id + "-title"}>
      <>
        <form method="dialog">
          <button aria-label="关闭面板">关闭 ×</button>
        </form>
        <p class="eyebrow">DISCOVERY / 可编辑占位</p>
        <h2 id={item.id + "-title"}>{item.title}</h2>
        <p>{item.text}</p>
      </>
    </dialog>
  ))
}
<script>
  let cleanupMotion: (() => void) | undefined;
  document.addEventListener("astro:before-swap", () => cleanupMotion?.());
  document.addEventListener("astro:page-load", () => {
    cleanupMotion?.();
    const atlas = document.querySelector<HTMLElement>(".atlas");
    if (atlas) {
      let visible = true;
      const update = () =>
        atlas.classList.toggle(
          "motion-paused",
          document.hidden || !document.hasFocus() || !visible
        );
      const observer = new IntersectionObserver(entries => {
        visible = entries[0].isIntersecting;
        update();
      });
      observer.observe(atlas);
      document.addEventListener("visibilitychange", update);
      window.addEventListener("focus", update);
      window.addEventListener("blur", update);
      update();
      cleanupMotion = () => {
        observer.disconnect();
        document.removeEventListener("visibilitychange", update);
        window.removeEventListener("focus", update);
        window.removeEventListener("blur", update);
      };
    }
    document
      .querySelectorAll<HTMLButtonElement>("[data-discovery]")
      .forEach(button => {
        button.addEventListener("click", () => {
          const panel = document.getElementById(
            button.dataset.discovery!
          ) as HTMLDialogElement;
          panel.showModal();
          panel.addEventListener("close", () => button.focus(), { once: true });
        });
      });
  });
</script>
