<dialog data-login class="polar-login" aria-labelledby="polar-login-title">
  <form method="dialog" class="polar-login-close">
    <button type="submit" aria-label="关闭登录窗口" autofocus>关闭</button>
  </form>
  <h2 id="polar-login-title">登录以留下观测</h2>
  <p>公开观测只展示昵称、头像、时间与内容。你的邮箱不会公开。</p>
  <div class="polar-actions">
    <button type="button" data-provider="google">使用 Google 登录</button>
    <button type="button" data-provider="github">使用 GitHub 登录</button>
  </div>
  <p data-login-status role="status"></p>
</dialog>
